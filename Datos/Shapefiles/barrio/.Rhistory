"<br>",
"Hurtos de bicicletas: ", sf_barrio_biciatraco$number_biciatraco),
fillColor = pal(sf_barrio_biciatraco$number_biciatraco),
fillOpacity = 1)%>%
addLegend(pal = pal,
values = sf_barrio_biciatraco$number_biciatraco,
opacity = 1,
title = "Hurto de bicicletas")
head(biciatraco_agg)
head(biciatraco)
biciatraco_agg <- st_join(biciatraco, sf_barrio)
head(biciatraco_agg)
# Entonces, la columna NOMBRE (nombre original) nos dice el total de hurtos por barrio
# Procedemos a crearla para la variable nueva que creamos biciatraco_agg
biciatraco_agg$number_biciatraco <- 1
#biciatraco_agg <- aggregate(number_biciatraco ~ NOMBRE, data = biciatraco_agg, FUN = sum)
biciatraco_agg <- aggregate(number_biciatraco ~ cod_barrio, data = biciatraco_agg, FUN = sum)
# Examinemos el resultado:
summary(biciatraco_agg$number_biciatraco)
nrow(biciatraco_agg)
nrow(sf_barrio)
# Hay missings porque existen barrios donde no han ocurrido hurtos.
# La base está lista para unirse con el shape de barrios por medio de la función left_join()
sf_barrio_biciatraco <- left_join(sf_barrio, biciatraco_agg)
summary(sf_barrio_biciatraco$number_biciatraco)
# Debemos reemplazar los missing con ceros
sf_barrio_biciatraco$number_biciatraco[is.na(sf_barrio_biciatraco$number_biciatraco)] <- 0
summary(sf_barrio_biciatraco$number_biciatraco)
# Ahora si ... las coropletas:
ggplot(sf_barrio_biciatraco, aes(fill = number_biciatraco)) +
geom_sf() +
scale_fill_gradient(low = "white", high = "red") +
labs(fill = "# de hurtos",
title = "Hurtos de bicicletas por atraco, por barrio",
subtitle = "2015 - 2021") +
theme(axis.text.x = element_blank(),
axis.text.y = element_blank(),
axis.ticks = element_blank())
# Guardar el archivo
save(sf_barrio_biciatraco, file = "D:/Emilio/Desktop/DirectoRio/barrio/sf_neighborhoods_suicide.rda")
