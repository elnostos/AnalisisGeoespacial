popup = paste("Mes:", biciatraco2021$mes_calendario,
"<br>",
"Día:", biciatraco2021$dia_nombre,
"<br>",
"Jornada:", biciatraco2021$jornada,
"<br>",
"Modalidad:", biciatraco2021$arma_medio))
pal <- colorNumeric("OrRd", sf_barrio_biciatraco$number_biciatraco)
leaflet()  %>%
addTiles('http://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
attribution = '&copy; <a href="http://openstreetmap.org">
OpenStreetMap</a> contributors') %>%
addPolygons(data = sf_barrio_biciatraco$geometry,
color = "black",
weight = 1,
popup = paste0("Barrio: ", sf_barrio_biciatraco$NOMBRE,
"<br>",
"Codigo: ", sf_barrio_biciatraco$CODIGO,
"<br>",
"Hurtos de bicicletas: ", sf_barrio_biciatraco$number_biciatraco),
fillColor = pal(sf_barrio_biciatraco$number_biciatraco),
fillOpacity = 1)%>%
addLegend(pal = pal,
values = sf_barrio_biciatraco$number_biciatraco,
opacity = 1,
title = "Hurto de bicicletas")
knitr::opts_chunk$set(echo = TRUE)
summary(cars)
plot(pressure)
